<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiDemoCrashWebview20261007.BingWebViewPage"
             Title="Bing">
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <WebView>
                <WebView.Source>
                    <UrlWebViewSource Url="{Binding WebViewUrl}"/>
                </WebView.Source>
            </WebView>

            <Border Grid.Row="1">
                <Button Text="Continue"  
                    x:Name="ContinueButton"
                    Clicked="OnCloseWebViewClicked"/>
            </Border>
    
        </Grid>
    </ContentPage.Content>
</ContentPage>
